{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiagramMender Config",
  "type": "object",
  "properties": {
    "ignore": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "rules": {
      "type": "object",
      "properties": {
        "noGraphKeyword": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "default": {}
    },

    "output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["text", "json"],
          "default": "text"
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "additionalProperties": false
}

